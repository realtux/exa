{
    "type": "module",
    "imports": {
        "#app/*.js": "./*.js"
    },
    "dependencies": {
        "@exajs/core": "../..",
        "luxon": "3.4.4",
        "nodemon": "2.0.4"
    },
    "scripts": {
        "watch": "nodemon -q --watch ../.. --ignore node_modules/ -e '*' -x 'node app.js || touch app.js'",
        "start": "node app.js",
        "console": "node app.js console $*",
        "__internal_test": "nodemon -q --watch ../.. --ignore node_modules/ -e '*' -x 'node app.js || touch app.js'"
    }
}
